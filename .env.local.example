# Session secret (min 32 chars, generate with: openssl rand -base64 32)
SESSION_SECRET=your-super-secret-session-key-min-32-chars-change-in-production

# OpenAI API Key (for chat, quiz generation, and embeddings)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# Optional: Embedding Provider ("openai" or "voyage")
# EMBEDDING_PROVIDER=openai

# Optional: Voyage AI API Key (if using voyage for embeddings)
# VOYAGE_API_KEY=pa-xxxxx